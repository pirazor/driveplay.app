# Port the proxy listens on
PORT=8787

# Allowed browser origins (comma-separated), or * for any.
# In production set this to your frontend origin, e.g. https://driveplay.app
CORS_ORIGINS=*

# Public base URL of THIS service (used to build absolute YouTube proxy URLs).
# Optional — auto-detected from the request when behind a normal proxy.
# PUBLIC_URL=https://api.driveplay.app

# Set to false to disable the YouTube subsystem entirely.
YOUTUBE_ENABLED=true

# Seconds to cache proxied HLS playlists (keep low for live).
PLAYLIST_CACHE_SECONDS=2
