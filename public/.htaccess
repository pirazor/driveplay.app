# SPA fallback for Apache / Hostinger hosting.
# Serves index.html for any path that isn't a real file or directory, so
# client-side (react-router) routes like /live and /youtube resolve on direct
# hits and refreshes.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
